REDIS_URL=redis://localhost:6379

OPENROUTER_API_KEY=your_openrouter_api_key_here

TTS_PROVIDER=elevenlabs

TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

ELEVENLABS_API_KEY=

ELEVENLABS_USE_MP3=true

PLAYHT_API_KEY=

PLAYHT_USER_ID=

STORAGE_TYPE=local

# Durable cross-host storage for finished videos. Required in the split deploy
# (app on Vercel, worker on Railway/Render/Fly): the worker uploads each MP4 to
# Vercel Blob so the app and browser can load it. Set the SAME token on BOTH the
# worker and the Vercel app. Leave empty for single-host/local dev (the worker
# then serves from public/temp directly).
BLOB_READ_WRITE_TOKEN=

UNSPLASH_ACCESS_KEY=

PEXELS_API_KEY=

OPENAI_API_KEY=

# Fraction of a video's shots allowed to fall back to the blank placeholder
# before image sourcing fails the job instead of shipping a render of grey
# plates. Default 0.5 (fail when MORE than half the shots are placeholders).
# 0 fails on any placeholder at all; >= 1 disables the floor entirely.
IMAGE_PLACEHOLDER_MAX_RATIO=0.5

# Server-side ceiling on requested video length, in seconds. Unset = 60,
# matching the UI slider max (DURATION_MAX). Raise it only if you have also
# raised the render timeout: a 4K render costs roughly real-time per second.
MAX_VIDEO_DURATION_SECONDS=60

MAX_VIDEO_OUTPUT_MB=

CLEANUP_ENABLED=true

VIDEO_RETENTION_HOURS=24

UPLOAD_RETENTION_HOURS=24

CLEANUP_INTERVAL_HOURS=1

JOB_RETENTION_DAYS=7

CLEANUP_SECRET=your_secret_here

DEFAULT_TOKENS=10

TOKENS_PER_VIDEO=10

FREE_PLAN_VIDEOS_PER_MONTH=3

FREE_PLAN_API_CALLS_PER_MONTH=3

RATE_LIMIT_ENABLED=true

RATE_LIMIT_GENERATE=5

RATE_LIMIT_UPLOAD=20

RATE_LIMIT_STATUS=60

RATE_LIMIT_GENERAL=100

# --- Veo / Vertex AI (talking-character mode) ---
# Veo runs on Vertex AI, not the AI Studio Gemini API: spend lands on the GCP
# project's billing account. REQUIRED - validateConfig() refuses to boot
# without the first two (src/lib/config/validate.ts).
GOOGLE_CLOUD_PROJECT=
# Region with Veo quota. Not optional: unset makes the SDK fall back to
# 'global', which does not serve Veo.
GOOGLE_CLOUD_LOCATION=us-central1
# Base64 of the whole service-account JSON key (base64 -w0 key.json).
# Decoded to a 0600 file under os.tmpdir() at boot, and
# GOOGLE_APPLICATION_CREDENTIALS is pointed at it (src/lib/veo/credentials.ts).
# Leave blank for local dev to use ambient ADC instead, e.g.
# ~/.gcp/cutline-veo.json or `gcloud auth application-default login`.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# Optional override. Default: veo-3.1-fast-generate-001 (GA).
VEO_MODEL=

HEYGEN_API_KEY=

RETRY_ENABLED=true

RETRY_LLM_MAX=3

RETRY_TTS_MAX=3

RETRY_IMAGE_MAX=2

RETRY_RENDER_MAX=2

RESEND_API_KEY=

CONTACT_TO_EMAIL=parbhat@parbhat.work

# Must be an address on a domain you verified at resend.com/domains.
# Resend onboarding@resend.dev only delivers to your Resend signup address,
# so it is not a safe default here. Unset means the route fails loudly.
CONTACT_FROM_EMAIL=

# --- Gross-margin circuit breaker ---
# Fraction of revenue retained. 0.5 = never spend more than half of what a
# customer pays on provider costs. This is what stops one seat from pulling
# five figures of Veo spend against a fixed subscription.
TARGET_GROSS_MARGIN=0.5

PLAN_PRICE_BEGINNER_USD=29
PLAN_PRICE_PROFESSIONAL_USD=59
PLAN_PRICE_ENTERPRISE_USD=299

# Provider spend allowed for a free account before it must upgrade.
FREE_PLAN_BUDGET_USD=0.6

# Talking-character seconds per month - the user-facing meter for talking_object.
# Veo is $0.40/s in fixed 8s blocks, so this is the line item that can blow
# the whole budget in one request; running out downgrades to the standard
# renderer rather than refusing the job.
CINEMATIC_SECONDS_FREE=0
CINEMATIC_SECONDS_BEGINNER=0
CINEMATIC_SECONDS_PROFESSIONAL=90
CINEMATIC_SECONDS_ENTERPRISE=400

# HeyGen's real rate is UNKNOWN and deliberately unset: avatar renders book $0
# against the margin ceiling and log an error until this is filled in.
COST_PER_HEYGEN_SECOND=

RATE_LIMIT_CONTACT=5

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Public by design - it is
# embedded in the page. Leave empty to disable analytics entirely; the layout
# then renders no GA script and every event helper is a no-op.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google OAuth. REQUIRED - the app refuses to boot without both
# (src/lib/config/validate.ts:validateAuthConfig, called from instrumentation.ts).
# Google is the only sign-in provider and signing in is the only way to generate,
# so an unset value takes the whole product down rather than degrading. The
# worker does not need these; validateConfig() deliberately does not require them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
